{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "uid": {
      "type": "uid",
      "targetField": "title"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "datetime"
    },
    "content": {
      "type": "blocks"
    },
    "picture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "autore": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Ricerca",
        "Viaggio",
        "Call",
        "Cartolina",
        "Intervista"
      ]
    },
    "featured": {
      "type": "boolean"
    }
  }
}
