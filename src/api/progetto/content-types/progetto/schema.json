{
  "kind": "collectionType",
  "collectionName": "progettos",
  "info": {
    "singularName": "progetto",
    "pluralName": "progettos",
    "displayName": "Progetto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "uid": {
      "type": "uid",
      "targetField": "title"
    },
    "title": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "main_picture": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "anno_inizio": {
      "type": "integer"
    },
    "anno_fine": {
      "type": "integer"
    },
    "territori": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ambito.ambito"
    },
    "project_status": {
      "type": "enumeration",
      "enum": [
        "archived",
        "in-progress"
      ]
    },
    "temi": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tema.tema"
    },
    "areas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::area.area"
    },
    "content": {
      "type": "blocks"
    },
    "team_Codici": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::team.team",
      "inversedBy": "progetti"
    },
    "prodotti": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::prodotto.prodotto",
      "mappedBy": "progetto"
    },
    "eventi": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evento.evento",
      "mappedBy": "progetto"
    },
    "calls": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::call.call",
      "mappedBy": "progetto"
    },
    "updates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::update.update",
      "mappedBy": "progetto"
    },
    "organizzazioni": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::organizzazione.organizzazione"
    },
    "persone": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::persone.persone"
    }
  }
}
